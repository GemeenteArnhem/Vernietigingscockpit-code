{
  "name": "vernietigingscockpit-code",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace @vernietigingscockpit/cockpit-web",
    "build:api": "npm run build --workspace @vernietigingscockpit/cockpit-api",
    "dev:web": "npm run dev --workspace @vernietigingscockpit/cockpit-web",
    "dev:api": "npm run start:dev --workspace @vernietigingscockpit/cockpit-api",
    "lint": "npm run lint --workspace @vernietigingscockpit/cockpit-web"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.13",
    "tailwindcss": "^3.4.19"
  }
}
