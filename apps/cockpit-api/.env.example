PORT=3000
CORS_ORIGIN=https://cockpit.domein.dev
OIDC_ISSUER=https://auth.cockpit.domein.dev/realms/vernietigingscockpit
OIDC_AUDIENCE=cockpit-api
# Database (ADR-0003): de API draait als aparte loginrol, lid van <DB_NAME>_app, met op de
# auditlogs alleen SELECT en INSERT. Migraties en het aanmaken van die rol draaien als eigenaar
# (MIGRATE_DATABASE_URL); zie README, paragraaf Database.
# TLS naar de database (CC-14): sslmode=require. Alleen voor een database op een intern
# Docker-netwerk zonder TLS-certificaat kan sslmode=disable; leg die keuze dan vast.
DATABASE_URL=postgresql://<APP_DB_USER>:<APP_DB_PASSWORD>@postgres:5432/<DB_NAME>?schema=public&sslmode=require
MIGRATE_DATABASE_URL=postgresql://<DB_EIGENAAR>:<DB_EIGENAAR_PASSWORD>@postgres:5432/<DB_NAME>?schema=public&sslmode=require
APP_DB_USER=cockpit_api
APP_DB_PASSWORD=<sterk wachtwoord, alleen in .env>
GOTENBERG_URL=https://pdf.cockpit.domein.dev
GOTENBERG_USERNAME=
GOTENBERG_PASSWORD=
# Archivering (CC-18, worker): map waarin per taak het dossier (verklaring, CSV-bijlage,
# auditlog en MDTO-XML) komt. In compose een volume op /archief; neem het op in de back-up.
ARCHIEF_PAD=/archief
# Werkkopie verwijderen na archivering (ADR-0006), ISO 8601-duren. WERKKOPIE_BEWAARTERMIJN is
# de beginwaarde; daarna wijzigt de functioneel beheerder hem via de beheer-API.
WERKKOPIE_BEWAARTERMIJN=P12M
OPSCHONING_INTERVAL=P1D

# Stekkers: het OAuth2-secret staat in env, de naam ervan in stekker_configuratie.secret_ref.
# De image draait met NODE_ENV=production; daar is stekkerauthenticatie 'none' niet toegestaan.
KC_STEKKER_CLIENT_SECRET=<secret van Keycloak-client cockpit-stekker>
# Stekkerbeheer (API en worker): sleutel voor de versleutelde stekker-secrets in de database
# (AES-256-GCM). 32 bytes, base64; maak hem met: openssl rand -base64 32. Bewaar hem goed:
# zonder deze sleutel zijn opgeslagen secrets onbruikbaar.
SECRET_ENCRYPTION_KEY=<32 bytes base64, alleen in .env>

# Alleen voor `npm run db:seed`: verbinding van de teststekker in de seed. Standaard poort 3100,
# zodat de teststekker lokaal niet botst met de API (3000): start hem met PORT=3100.
SEED_STEKKER_BASE_URL=http://localhost:3100
SEED_STEKKER_AUTH_TYPE=none
SEED_STEKKER_TOKEN_URL=https://auth.cockpit.domein.dev/realms/vernietigingscockpit/protocol/openid-connect/token
SEED_STEKKER_CLIENT_ID=cockpit-stekker
SEED_STEKKER_SECRET_REF=KC_STEKKER_CLIENT_SECRET

# Lokaal: worker in het API-proces (true), of apart met `npm run start:worker:dev` (false).
SELECTIE_WORKER_ENABLED=false
WORKER_LEASE_MS=300000
