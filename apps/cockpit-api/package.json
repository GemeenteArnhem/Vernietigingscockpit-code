{
  "name": "@vernietigingscockpit/cockpit-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch --conditions=source src/main.ts",
    "start:worker": "node dist/worker.js",
    "start:worker:dev": "tsx watch --conditions=source src/worker.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --conditions=source prisma/seed.ts",
    "db:app-gebruiker": "node scripts/db-app-gebruiker.mjs",
    "test": "vitest run --project unit",
    "test:integratie": "vitest run --project integratie",
    "test:watch": "vitest --project unit"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@vernietigingscockpit/api-contract": "0.0.0",
    "helmet": "^8.3.0",
    "jwks-rsa": "^4.1.0",
    "nestjs-pino": "^5.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^24.19.0",
    "@types/passport-jwt": "^4.0.1",
    "@vernietigingscockpit/stekker-client": "1.0.0",
    "prisma": "7.10.0",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
