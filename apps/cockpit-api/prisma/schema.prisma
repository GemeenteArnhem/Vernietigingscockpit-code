generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AppRole {
  recordmanager
  proceseigenaar
  archivaris
  functioneel_beheerder
  auditor
}

enum Frequentie {
  jaarlijks
  kwartaal
  maandelijks
  ad_hoc
}

enum TaakStatus {
  init
  beoordeling
  accordering_po
  accordering_archivaris
  vrijgegeven
  uitvoering
  resultaat
  archief
}

enum AuditActorType {
  user
  system
}

model Afdeling {
  id          String       @id @default(uuid()) @db.Uuid
  naam        String
  code        String       @unique
  actief      Boolean      @default(true)
  medewerkers Medewerker[]

  @@map("afdeling")
}

model Medewerker {
  id                          String            @id @default(uuid()) @db.Uuid
  naam                        String
  email                       String            @unique
  rollen                      AppRole[]
  afdelingId                  String?           @map("afdeling_id") @db.Uuid
  afdeling                    Afdeling?         @relation(fields: [afdelingId], references: [id])
  actief                      Boolean           @default(true)
  bron                        String
  externId                    String?           @map("extern_id")
  gebruiker                   Gebruiker?
  taakdefinitiesRecordmanager Taakdefinitie[]   @relation("TaakdefinitieRecordmanager")
  taakdefinitiesPo            Taakdefinitie[]   @relation("TaakdefinitieProceseigenaar")
  taakdefinitiesArchivaris    Taakdefinitie[]   @relation("TaakdefinitieArchivaris")
  takenRecordmanager          Taakinstantie[]   @relation("TaakinstantieRecordmanager")
  takenPo                     Taakinstantie[]   @relation("TaakinstantieProceseigenaar")
  takenArchivaris             Taakinstantie[]   @relation("TaakinstantieArchivaris")

  @@map("medewerker")
}

model Gebruiker {
  id            String      @id
  medewerkerId  String?     @unique @map("medewerker_id") @db.Uuid
  medewerker    Medewerker? @relation(fields: [medewerkerId], references: [id])
  naam          String
  email         String?
  rollen        AppRole[]
  laatstGezien  DateTime    @default(now()) @map("laatst_gezien")

  @@map("gebruiker")
}

model Stekker {
  id             String                  @id @default(uuid()) @db.Uuid
  naam           String
  omschrijving   String?
  actief         Boolean                 @default(true)
  configuraties  StekkerConfiguratie[]
  taakdefinities TaakdefinitieStekker[]

  @@map("stekker")
}

model StekkerConfiguratie {
  id                  String    @id @default(uuid()) @db.Uuid
  stekkerId           String    @map("stekker_id") @db.Uuid
  stekker             Stekker   @relation(fields: [stekkerId], references: [id])
  versie              Int
  baseUrl             String    @map("base_url")
  authType            String    @map("auth_type")
  tokenUrl            String?   @map("token_url")
  clientId            String?   @map("client_id")
  secretRef           String?   @map("secret_ref")
  scopes              String[]
  parameters          Json
  verwachteApiMajor   Int       @map("verwachte_api_major")
  timeouts            Json
  aangemaaktDoor      String    @map("aangemaakt_door")
  aangemaaktOp        DateTime  @default(now()) @map("aangemaakt_op")
  selecties           Selectie[]

  @@unique([stekkerId, versie])
  @@map("stekker_configuratie")
}

model Taakdefinitie {
  id                 String                 @id @default(uuid()) @db.Uuid
  naam               String
  omschrijving       String?
  categorie          String
  frequentie         Frequentie
  startmaand         Int?                   @map("startmaand")
  recordmanagerId    String                 @map("recordmanager_id") @db.Uuid
  proceseigenaarId   String                 @map("proceseigenaar_id") @db.Uuid
  archivarisId       String                 @map("archivaris_id") @db.Uuid
  recordmanager      Medewerker             @relation("TaakdefinitieRecordmanager", fields: [recordmanagerId], references: [id])
  proceseigenaar     Medewerker             @relation("TaakdefinitieProceseigenaar", fields: [proceseigenaarId], references: [id])
  archivaris         Medewerker             @relation("TaakdefinitieArchivaris", fields: [archivarisId], references: [id])
  actief             Boolean                @default(true)
  versie             Int                    @default(1)
  stekkers           TaakdefinitieStekker[]
  instanties         Taakinstantie[]

  @@map("taakdefinitie")
}

model TaakdefinitieStekker {
  taakdefinitieId    String         @map("taakdefinitie_id") @db.Uuid
  stekkerId          String         @map("stekker_id") @db.Uuid
  taakdefinitie      Taakdefinitie  @relation(fields: [taakdefinitieId], references: [id])
  stekker            Stekker        @relation(fields: [stekkerId], references: [id])
  selectieparameters Json           @map("selectieparameters")

  @@id([taakdefinitieId, stekkerId])
  @@map("taakdefinitie_stekker")
}

model Taakinstantie {
  id                 String          @id @default(uuid()) @db.Uuid
  taakdefinitieId    String          @map("taakdefinitie_id") @db.Uuid
  taakdefinitie      Taakdefinitie   @relation(fields: [taakdefinitieId], references: [id])
  naam               String
  status             TaakStatus
  stapSinds          DateTime        @default(now()) @map("stap_sinds")
  ronde              Int             @default(1)
  peildatum          DateTime?       @db.Date
  recordmanagerId    String          @map("recordmanager_id") @db.Uuid
  proceseigenaarId   String          @map("proceseigenaar_id") @db.Uuid
  archivarisId       String          @map("archivaris_id") @db.Uuid
  recordmanager      Medewerker      @relation("TaakinstantieRecordmanager", fields: [recordmanagerId], references: [id])
  proceseigenaar     Medewerker      @relation("TaakinstantieProceseigenaar", fields: [proceseigenaarId], references: [id])
  archivaris         Medewerker      @relation("TaakinstantieArchivaris", fields: [archivarisId], references: [id])
  gestartOp          DateTime?       @map("gestart_op")
  afgerondOp         DateTime?       @map("afgerond_op")
  versie             Int             @default(1)
  selecties          Selectie[]
  verklaringen       Verklaring[]
  auditEvents        AuditEvent[]
  outboxItems        Outbox[]

  @@map("taakinstantie")
}

model Verklaring {
  id               String          @id @default(uuid()) @db.Uuid
  taakinstantieId  String          @map("taakinstantie_id") @db.Uuid
  taakinstantie    Taakinstantie   @relation(fields: [taakinstantieId], references: [id])
  versie           Int
  status           String
  pdf              Bytes
  pdfSha256        String          @map("pdf_sha256")
  csv              Bytes
  csvSha256        String          @map("csv_sha256")
  csvBestandsnaam  String          @map("csv_bestandsnaam")
  metadata         Json
  gegenereerdOp    DateTime        @default(now()) @map("gegenereerd_op")
  gegenereerdDoor  String?         @map("gegenereerd_door")

  @@unique([taakinstantieId, versie])
  @@index([taakinstantieId, gegenereerdOp])
  @@map("verklaring")
}

model Selectie {
  id                       String                @id @default(uuid()) @db.Uuid
  taakinstantieId          String                @map("taakinstantie_id") @db.Uuid
  taakinstantie            Taakinstantie         @relation(fields: [taakinstantieId], references: [id])
  stekkerId                String                @map("stekker_id") @db.Uuid
  stekkerConfiguratieId    String                @map("stekker_configuratie_id") @db.Uuid
  stekkerConfiguratie      StekkerConfiguratie   @relation(fields: [stekkerConfiguratieId], references: [id])
  externSelectieId         String?               @map("extern_selectie_id")
  status                   String
  peildatum                DateTime?             @db.Date
  selectietijdstip         DateTime?
  totaalKandidaten         Int                   @default(0) @map("totaal_kandidaten")
  totaalObjecten           Int                   @default(0) @map("totaal_objecten")
  totaalBetrokkenen        Int                   @default(0) @map("totaal_betrokkenen")
  stekkerversie            String?
  configuratieversie       String?
  apiVersie                String?               @map("api_versie")
  geimporteerd             Int                   @default(0)
  fout                     String?
  externVernietigingId     String?               @map("extern_vernietiging_id")
  vernietigingStatus       String?               @map("vernietiging_status")
  vernietigingGestartOp    DateTime?             @map("vernietiging_gestart_op")
  vernietigingAfgerondOp   DateTime?             @map("vernietiging_afgerond_op")
  vernietigingResultaat    Json?                 @map("vernietiging_resultaat")
  kandidaten               Vernietigingskandidaat[]

  @@index([taakinstantieId])
  @@map("selectie")
}

model Vernietigingskandidaat {
  id                         String    @id @default(uuid()) @db.Uuid
  selectieId                 String    @map("selectie_id") @db.Uuid
  selectie                   Selectie  @relation(fields: [selectieId], references: [id])
  kandidaatId                String    @map("kandidaat_id")
  bronId                     String    @map("bron_id")
  bronIdNaam                 String?   @map("bron_id_naam")
  omschrijving               String
  classificatieschema        String?
  classificatiesleutel       String?
  classificatieomschrijving  String?
  selectielijst              String?
  grondslag                  String?
  grondslagAfwijkend         String?   @map("grondslag_afwijkend")
  resultaat                  String?
  bewaartermijn              String?
  waardering                 String?
  begindatum                 DateTime? @db.Date
  einddatum                  DateTime? @db.Date
  vernietigingsdatum         DateTime? @db.Date
  aantalObjecten             Int       @default(0) @map("aantal_objecten")
  aantalBetrokkenen          Int       @default(0) @map("aantal_betrokkenen")
  relatieType                String?   @map("relatie_type")
  relatieId                  String?   @map("relatie_id")
  bron                       Json
  beoordeling                String    @default("OPGENOMEN")
  uitsluitReden              String?   @map("uitsluit_reden")
  toelichting                String?
  beoordeeldDoor             String?   @map("beoordeeld_door") @db.Uuid
  versie                     Int       @default(1)

  @@unique([selectieId, kandidaatId])
  @@index([selectieId, beoordeling])
  @@index([vernietigingsdatum])
  @@index([grondslag])
  @@map("vernietigingskandidaat")
}

model AuditEvent {
  id              BigInt          @id @default(autoincrement())
  taakinstantieId String          @map("taakinstantie_id") @db.Uuid
  taakinstantie   Taakinstantie   @relation(fields: [taakinstantieId], references: [id])
  tijdstip        DateTime        @default(now())
  actorType       AuditActorType  @map("actor_type")
  actorId         String?         @map("actor_id")
  actorNaam       String?         @map("actor_naam")
  rol             AppRole?
  actie           String
  entiteitType    String          @map("entiteit_type")
  entiteitId      String          @map("entiteit_id")
  details         Json
  correlatieId    String?         @map("correlatie_id")
  vorigeHash      String?         @map("vorige_hash")
  hash            String

  @@map("audit_event")
}

model ConfiguratieEvent {
  id            BigInt          @id @default(autoincrement())
  tijdstip      DateTime        @default(now())
  actorType     AuditActorType  @map("actor_type")
  actorId       String?         @map("actor_id")
  actorNaam     String?         @map("actor_naam")
  rol           AppRole?
  actie         String
  entiteitType  String          @map("entiteit_type")
  entiteitId    String          @map("entiteit_id")
  details       Json
  correlatieId  String?         @map("correlatie_id")
  vorigeHash    String?         @map("vorige_hash")
  hash          String

  @@map("configuratie_event")
}

model Outbox {
  id              String          @id @default(uuid()) @db.Uuid
  taakinstantieId String?         @map("taakinstantie_id") @db.Uuid
  taakinstantie   Taakinstantie?  @relation(fields: [taakinstantieId], references: [id])
  queue           String
  jobNaam         String          @map("job_naam")
  payload         Json
  aangemaaktOp    DateTime        @default(now()) @map("aangemaakt_op")
  verzondenOp     DateTime?       @map("verzonden_op")

  @@map("outbox")
}
