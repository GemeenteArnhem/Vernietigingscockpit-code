COMPOSE_PROJECT_NAME=vernietigingscockpit

# Traefik moet al draaien op deze externe Docker-network.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINTS=websecure
TRAEFIK_TLS=true
TRAEFIK_CERTRESOLVER=letsencrypt

# Docker-network waarop PostgreSQL intern bereikbaar is.
DATABASE_NETWORK=intern

# Publieke domeinen.
WEB_DOMAIN=cockpit.domein.dev
API_DOMAIN=api.cockpit.domein.dev

# Container-, router- en servicenaam overrides.
WEB_CONTAINER_NAME=cockpit-web
API_CONTAINER_NAME=cockpit-api
WEB_TRAEFIK_ROUTER_NAME=cockpit-web
API_TRAEFIK_ROUTER_NAME=cockpit-api
WEB_TRAEFIK_SERVICE_NAME=cockpit-web
API_TRAEFIK_SERVICE_NAME=cockpit-api

# API runtimeconfiguratie.
API_HEALTHCHECK_URL=http://127.0.0.1:3000/api/v1/health/ready
API_CORS_ORIGIN=https://cockpit.domein.dev
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@postgres:5432/<DB_NAME>?schema=public&sslmode=disable
# Alleen nodig tijdens docker build voor `prisma generate`; hoeft geen echte database te zijn.
PRISMA_GENERATE_DATABASE_URL=postgresql://prisma:prisma@postgres:5432/prisma?schema=public&sslmode=disable
OIDC_ISSUER=https://auth.cockpit.domein.dev/realms/vernietigingscockpit
OIDC_AUDIENCE=cockpit-api
GOTENBERG_URL=https://pdf.cockpit.domein.dev
GOTENBERG_USERNAME=
GOTENBERG_PASSWORD=
SELECTIE_WORKER_ENABLED=true
SELECTIE_WORKER_INTERVAL_MS=5000

# Web buildconfiguratie. Deze waarden worden tijdens docker build in de Vite-bundel gezet.
WEB_HEALTHCHECK_URL=http://127.0.0.1:8080/healthz
WEB_AUTH_ENABLED=false
WEB_OIDC_AUTHORITY=https://auth.cockpit.domein.dev/realms/vernietigingscockpit
WEB_OIDC_CLIENT_ID=cockpit-web
WEB_OIDC_REDIRECT_URI=https://cockpit.domein.dev/auth/callback
WEB_OIDC_POST_LOGOUT_REDIRECT_URI=https://cockpit.domein.dev/
WEB_OIDC_SCOPE=openid profile email
WEB_API_BASE_URL=https://api.cockpit.domein.dev/api/v1
