COMPOSE_PROJECT_NAME=vernietigingscockpit

# Traefik moet al draaien op deze externe Docker-network.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINTS=websecure
TRAEFIK_TLS=true
TRAEFIK_CERTRESOLVER=letsencrypt

# Docker-network waarop PostgreSQL intern bereikbaar is.
DATABASE_NETWORK=intern

# Publieke domeinen.
WEB_DOMAIN=cockpit.domein.dev
API_DOMAIN=api.cockpit.domein.dev

# Container-, router- en servicenaam overrides.
WEB_CONTAINER_NAME=cockpit-web
API_CONTAINER_NAME=cockpit-api
WEB_TRAEFIK_ROUTER_NAME=cockpit-web
API_TRAEFIK_ROUTER_NAME=cockpit-api
WEB_TRAEFIK_SERVICE_NAME=cockpit-web
API_TRAEFIK_SERVICE_NAME=cockpit-api

# API runtimeconfiguratie.
API_HEALTHCHECK_URL=http://127.0.0.1:3000/api/v1/health/ready
API_CORS_ORIGIN=https://cockpit.domein.dev
# Database (ADR-0003): de API draait als aparte loginrol, lid van <DB_NAME>_app, met op de
# auditlogs alleen SELECT en INSERT. Migraties en het aanmaken van die rol draaien als eigenaar
# (MIGRATE_DATABASE_URL); zie README, paragraaf Database.
# TLS naar de database (CC-14): sslmode=require. Alleen voor een database op een intern
# Docker-netwerk zonder TLS-certificaat kan sslmode=disable; leg die keuze dan vast.
DATABASE_URL=postgresql://<APP_DB_USER>:<APP_DB_PASSWORD>@postgres:5432/<DB_NAME>?schema=public&sslmode=require
MIGRATE_DATABASE_URL=postgresql://<DB_EIGENAAR>:<DB_EIGENAAR_PASSWORD>@postgres:5432/<DB_NAME>?schema=public&sslmode=require
APP_DB_USER=cockpit_api
APP_DB_PASSWORD=<sterk wachtwoord, alleen in .env>
# Alleen nodig tijdens docker build voor `prisma generate`; hoeft geen echte database te zijn.
PRISMA_GENERATE_DATABASE_URL=postgresql://prisma:prisma@postgres:5432/prisma?schema=public&sslmode=disable
OIDC_ISSUER=https://auth.cockpit.domein.dev/realms/vernietigingscockpit
OIDC_AUDIENCE=cockpit-api
GOTENBERG_URL=https://pdf.cockpit.domein.dev
GOTENBERG_USERNAME=
GOTENBERG_PASSWORD=
# Archivering (CC-18, worker): map waarin per taak het dossier (verklaring, CSV-bijlage,
# auditlog en MDTO-XML) komt. In compose een volume op /archief; neem het op in de back-up.
ARCHIEF_PAD=/archief
# Werkkopie verwijderen na archivering (ADR-0006), ISO 8601-duren. WERKKOPIE_BEWAARTERMIJN is
# de beginwaarde; daarna wijzigt de functioneel beheerder hem via de beheer-API.
WERKKOPIE_BEWAARTERMIJN=P12M
OPSCHONING_INTERVAL=P1D
# Worker (service cockpit-worker): interval en lease. Na de lease neemt een andere worker
# een vastgelopen job over. De worker verlengt de lease vóór en na elke stekkeraanroep;
# houd hem daarom ruim boven één stekker-time-out (requestMs) plus het vastleggen.
SELECTIE_WORKER_INTERVAL_MS=5000
WORKER_LEASE_MS=300000
# Statusvragen aan de stekker tijdens een vernietiging: eerste na 2 s, daarna oplopend tot 60 s.
WORKER_POLL_START_MS=2000
WORKER_POLL_MAX_MS=60000

# API-hardening (CC-11). Rate limit per ingelogde gebruiker en per IP zonder login.
RATE_LIMIT_GEBRUIKER_PER_MINUUT=300
RATE_LIMIT_ANONIEM_PER_MINUUT=60
# Proxies waarvan X-Forwarded-For wordt vertrouwd (Express 'trust proxy').
TRUST_PROXY=loopback, linklocal, uniquelocal
# Logniveau (pino, JSON): trace, debug, info, warn, error.
LOG_LEVEL=info

# Stekkers: het OAuth2-secret staat in env, de naam ervan in stekker_configuratie.secret_ref.
# De image draait met NODE_ENV=production; daar is stekkerauthenticatie 'none' niet toegestaan.
KC_STEKKER_CLIENT_SECRET=<secret van Keycloak-client cockpit-stekker>
# Stekkerbeheer (API en worker): sleutel voor de versleutelde stekker-secrets in de database
# (AES-256-GCM). 32 bytes, base64; maak hem met: openssl rand -base64 32. Bewaar hem goed:
# zonder deze sleutel zijn opgeslagen secrets onbruikbaar.
SECRET_ENCRYPTION_KEY=<32 bytes base64, alleen in .env>

# Alleen voor `npm run db:seed`: verbinding van de teststekker in de seed. Standaard poort 3100,
# zodat de teststekker lokaal niet botst met de API (3000): start hem met PORT=3100.
SEED_STEKKER_BASE_URL=http://localhost:3100
SEED_STEKKER_AUTH_TYPE=none
SEED_STEKKER_TOKEN_URL=https://auth.cockpit.domein.dev/realms/vernietigingscockpit/protocol/openid-connect/token
SEED_STEKKER_CLIENT_ID=cockpit-stekker
SEED_STEKKER_SECRET_REF=KC_STEKKER_CLIENT_SECRET

# Web buildconfiguratie. Deze waarden worden tijdens docker build in de Vite-bundel gezet.
WEB_HEALTHCHECK_URL=http://127.0.0.1:8080/healthz
# Inloggen staat in een productiebuild altijd aan; uitzetten kan alleen lokaal met vite dev.
WEB_AUTH_ENABLED=true
WEB_OIDC_AUTHORITY=https://auth.cockpit.domein.dev/realms/vernietigingscockpit
WEB_OIDC_CLIENT_ID=cockpit-web
WEB_OIDC_REDIRECT_URI=https://cockpit.domein.dev/auth/callback
WEB_OIDC_POST_LOGOUT_REDIRECT_URI=https://cockpit.domein.dev/
WEB_OIDC_SCOPE=openid profile email
WEB_API_BASE_URL=https://api.cockpit.domein.dev/api/v1
